#!/bin/bash
#PBS -N video_tldpo_full
#PBS -P hn98
#PBS -q gpuvolta
#PBS -l ngpus=1
#PBS -l walltime=24:00:00
#PBS -l mem=96GB
#PBS -j oe
set -euo pipefail
PROJECT=/scratch/hn98/dd9648/Video-TL-DPO
ENV=${VIDEO_TLDPO_ENV:-$PROJECT/.venv}
export HF_HOME=${HF_HOME:-$PROJECT/cache/huggingface}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-$HF_HOME/transformers}
mkdir -p "$PROJECT/outputs/full_tl_dpo" "$HF_HOME"
source "$ENV/bin/activate"; cd "$PROJECT"
python scripts/train.py --config configs/tl_full.yaml
